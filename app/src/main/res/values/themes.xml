<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.github.com/tools">

    <style name="Theme.GradeMate" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Remove default Android 12+ splash logo icon to avoid double logo flash -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        
        <!-- Match native system splash background with app primary blue -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#4FACFE</item>
    </style>
</resources>